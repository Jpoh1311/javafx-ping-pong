<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.example.pingpong.HelloController"
            xmlns:fx="http://javafx.com/fxml">

    <top>
        <MenuBar>
            <menus>

                <Menu text="Game">
                    <items>
                        <MenuItem text="Set Player Names..." onAction="#onSetPlayerNames"/>
                        <MenuItem text="Exit" onAction="#onExit"/>
                    </items>
                </Menu>

                <Menu text="Settings">
                    <items>
                        <MenuItem text="Ball Speed..." onAction="#onSetBallSpeed"/>
                        <MenuItem text="Racket Dimensions..." onAction="#onSetRacketDimensions"/>
                        <MenuItem text="Winning Score..." onAction="#onSetWinningScore"/>
                        <MenuItem text="Speed Increase Interval..." onAction="#onSetSpeedIncreaseEvery"/>
                    </items>
                </Menu>

            </menus>
        </MenuBar>
    </top>

    <center>
        <Pane fx:id="playfield" style="-fx-background-color: black;" />
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 8; -fx-background-color: #f2f2f2;">
            <Label fx:id="leftScoreLabel" style="-fx-font-size: 16px;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="rightScoreLabel" style="-fx-font-size: 16px;" />
        </HBox>
    </bottom>


</BorderPane>
